{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-dialog",
  "description": "Allow native dialogs, clipboard, notifications, shell helpers, and tray/window lifecycle commands.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-read-image",
    "notification:default",
    "allow-open-external-url",
    "allow-open-path",
    "allow-reveal-item-in-dir",
    "allow-list-apps-for-file",
    "allow-open-path-with",
    "allow-popup-native-menu",
    "allow-set-close-quits",
    "allow-quit-app",
    "allow-show-main-window-cmd",
    "allow-set-ui-theme",
    "allow-get-desktop-api-token"
  ]
}
